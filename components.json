{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-lyra",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.ts",
    "css": "src/app.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "phosphor",
  "rtl": false,
  "aliases": {
    "components": "$lib/components",
    "utils": "$lib/lib/utils",
    "ui": "$lib/components/ui",
    "lib": "$lib/lib",
    "hooks": "$lib/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@kokonutui": "https://kokonutui.com/r/{name}.json"
  }
}
